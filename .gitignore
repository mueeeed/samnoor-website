# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# PHP backend runtime state — lives on the deployed server, not shipped by
# code deploys. blog-posts.json is tracked (it's the initial seed content);
# everything else here is created at runtime.
/php-api/data/enquiries.json
/php-api/data/newsletter-subscribers.json
/php-api/data/rate-limit.json
/php-api/config.php

# blog CMS uploads — same reasoning as above
/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/session state
.claude/

# Local Netlify folder
.netlify

# Raw source images (large, already processed into public/fabrics and other used assets)
/Assets/

# Session task log — kept local since it records credentials in plain text
/TASKS.md
